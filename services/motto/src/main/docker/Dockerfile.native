# UBI 9, because the builder is UBI 9. This pairing is the whole content of this
# line: a native binary is linked against the glibc of the image it was compiled
# in, and running it on an older one fails at exec with
#
#   ./application: /lib64/libc.so.6: version `GLIBC_2.34' not found
#
# in a restart loop that looks, from outside, like a routing problem. The
# builder is pinned in the release workflow; if it moves, this moves with it.
#
# Anything else here is deliberate absence: no shell tools, no package manager,
# nothing to exploit that the application does not need.
FROM quay.io/quarkus/ubi9-quarkus-micro-image:2.0

WORKDIR /work/
RUN chown 1001 /work && chmod "g+rwX" /work && chown 1001:root /work

COPY --chown=1001:root target/*-runner /work/application

EXPOSE 8080
USER 1001

# Binding to the container's own loopback would make the port unreachable from
# outside it, which looks exactly like a crashed service.
ENTRYPOINT ["./application", "-Dquarkus.http.host=0.0.0.0"]
