<?xml version="1.0" encoding="utf-8"?>
<!-- Three lines and nothing else. A widget competes with everything else on
     the screen, and the one that wins is the one that can be read without
     being looked at. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="@drawable/motto_widget_background">

    <TextView
        android:id="@+id/widget_day"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="12sp"
        android:letterSpacing="0.1"
        android:textColor="#8A8A8A" />

    <TextView
        android:id="@+id/widget_action"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="6dp"
        android:textSize="15sp"
        android:textColor="#F2F2F2"
        android:maxLines="3"
        android:ellipsize="end" />

    <TextView
        android:id="@+id/widget_streak"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:textSize="12sp"
        android:textColor="#8A8A8A" />
</LinearLayout>
