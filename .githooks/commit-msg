#!/usr/bin/env bash
#
# Spec: https://www.conventionalcommits.org/
#
# Examples:
#   feat: add user login
#   fix(auth): fix token refresh bug
#   feat!: change API contract
#   chore(deps): bump dependencies

commit_msg_file="$1"
subject="$(grep -v '^#' "$commit_msg_file" | sed '/^[[:space:]]*$/d' | head -n1)"

case "$subject" in
  "Merge "*|"Revert "*|"fixup!"*|"squash!"*) exit 0 ;;
esac

types="feat|fix|docs|style|refactor|perf|test|build|ci|chore|revert"

pattern="^(${types})(\([a-z0-9._-]+\))?(!)?: .+"

if echo "$subject" | grep -Eq "$pattern"; then
  exit 0
fi

echo "" >&2
echo "  Commit message does not follow Conventional Commits." >&2
echo "" >&2
echo "  Got     : $subject" >&2
echo "" >&2
echo "  Expected: <type>(<scope>)?: <description>" >&2
echo "  Types   : ${types//|/, }" >&2
echo "" >&2
echo "  Examples:" >&2
echo "    feat: add user login" >&2
echo "    fix(auth): fix token refresh bug" >&2
echo "    chore(deps): bump dependencies" >&2
echo "" >&2
exit 1
