          "points" : {
            "type" : "integer",
            "format" : "int32"
          }
        }
      },
      "SupportCopy" : {
        "type" : "object",
        "required" : [ "version", "privacy", "deletion", "faq", "privacyPolicyUrl" ],
        "properties" : {
          "version" : {
            "type" : "string"
          },
          "privacy" : {
            "type" : "array",
            "items" : {
              "type" : "string"
            }
          },
          "deletion" : {
            "$ref" : "#/components/schemas/DeletionCopy"
