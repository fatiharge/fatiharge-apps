        "properties" : {
          "goes" : {
            "type" : "array",
            "items" : {
              "type" : "string"
            }
          },
          "stays" : {
            "type" : "array",
            "items" : {
              "type" : "string"
            }
          },
          "counterReason" : {
            "type" : "string"
          },
          "answersNote" : {
            "type" : "string"
          }
        }
      },
      "DeletionResponse" : {
        "type" : "object",
        "required" : [ "deleted", "kept" ],
        "properties" : {
          "deleted" : {
            "type" : "array",
            "items" : {
              "type" : "string"
            }
          },
          "kept" : {
            "type" : "array",
            "items" : {
              "type" : "string"
            }
          }
        }
      },
      "DimensionReading" : {
        "type" : "object",
        "required" : [ "dimension", "band", "score", "text" ],
        "properties" : {
          "dimension" : {
            "type" : "string"
          },
          "band" : {
            "type" : "string"
          },
          "score" : {
            "type" : "number",
            "format" : "double"
          },
          "text" : {
            "type" : "string"
          }
        }
      },
      "EntitlementResponse" : {
        "type" : "object",
        "required" : [ "remainingUses", "skipsLeft", "premium" ],
