          "name" : {
            "type" : "string"
          },
          "occurredAt" : {
            "type" : "string",
            "$ref" : "#/components/schemas/Instant"
          },
          "properties" : {
            "type" : "object",
            "additionalProperties" : {
              "type" : "string"
            }
          }
        }
      },
      "FaqEntry" : {
        "type" : "object",
        "required" : [ "id", "question", "answer" ],
        "properties" : {
          "id" : {
            "type" : "string"
          },
          "question" : {
            "type" : "string"
          },
          "answer" : {
            "type" : "string"
          }
        }
      },
      "FeedbackKind" : {
        "type" : "string",
        "enum" : [ "BUG", "SUGGESTION", "CONTENT", "ARCHETYPE_REJECTED", "OTHER" ]
