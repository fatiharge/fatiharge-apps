          "archetypeId" : {
            "type" : "string"
          },
          "index" : {
            "type" : "integer",
            "format" : "int32"
          },
          "text" : {
            "type" : "string"
          }
        }
      },
      "Instant" : {
        "type" : "string",
        "format" : "date-time",
        "examples" : [ "2022-03-10T16:15:50Z" ]
      },
      "Leaderboard" : {
        "type" : "object",
        "required" : [ "week", "entries", "yourBest", "rewardedRanks" ],
        "properties" : {
          "week" : {
            "type" : "string",
            "$ref" : "#/components/schemas/LocalDate"
          },
          "entries" : {
            "type" : "array",
            "items" : {
              "$ref" : "#/components/schemas/LeaderboardEntry"
            }
          },
          "yourBest" : {
            "type" : "integer",
            "format" : "int32"
          },
          "rewardedRanks" : {
            "type" : "integer",
            "format" : "int32"
          }
        }
      },
      "LeaderboardEntry" : {
        "type" : "object",
        "required" : [ "rank", "points", "you" ],
        "properties" : {
          "rank" : {
            "type" : "integer",
            "format" : "int32"
          },
          "points" : {
            "type" : "integer",
            "format" : "int32"
          },
          "you" : {
            "type" : "boolean"
          }
        }
      },
      "LocalDate" : {
        "type" : "string",
        "format" : "date",
        "examples" : [ "2022-03-10" ]
      },
      "MarkDayRequest" : {
        "type" : "object",
        "required" : [ "day" ],
        "properties" : {
          "day" : {
            "type" : "string",
            "$ref" : "#/components/schemas/LocalDate"
          },
          "today" : {
            "$ref" : "#/components/schemas/LocalDate"
          }
        }
      },
      "MarkedDay" : {
        "type" : "object",
        "required" : [ "day", "madeUp" ],
        "properties" : {
          "day" : {
            "type" : "string",
            "$ref" : "#/components/schemas/LocalDate"
          },
          "madeUp" : {
            "type" : "boolean"
          }
        }
      },
      "MottoContent" : {
        "type" : "object",
        "required" : [ "id", "archetypeId", "motto", "detail", "reminder" ],
        "properties" : {
          "id" : {
            "type" : "string"
          },
          "archetypeId" : {
            "type" : "string"
          },
          "motto" : {
            "type" : "string"
          },
          "detail" : {
            "type" : "string"
          },
          "reminder" : {
            "type" : "string"
          }
        }
      },
      "NextPeriodRequest" : {
        "type" : "object",
