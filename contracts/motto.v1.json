      "ResultResponse" : {
        "type" : "object",
        "required" : [ "id", "archetype", "entitlement" ],
        "properties" : {
          "id" : {
            "type" : "integer",
            "format" : "int64"
          },
          "archetype" : {
            "$ref" : "#/components/schemas/ArchetypeResponse"
          },
          "entitlement" : {
            "$ref" : "#/components/schemas/EntitlementResponse"
          }
        }
      },
      "ResultSummary" : {
        "type" : "object",
        "required" : [ "id", "archetype", "profile", "claimedAt" ],
        "properties" : {
          "id" : {
            "type" : "integer",
            "format" : "int64"
          },
          "archetype" : {
            "$ref" : "#/components/schemas/ArchetypeResponse"
          },
          "profile" : {
            "$ref" : "#/components/schemas/ProfileScores"
