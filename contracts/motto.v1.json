{
  "openapi" : "3.1.0",
  "components" : {
    "schemas" : {
      "AnswerSubmission" : {
        "type" : "object",
        "required" : [ "answers", "spendSkip" ],
        "properties" : {
          "answers" : {
            "type" : "object",
            "additionalProperties" : {
              "type" : "integer",
              "format" : "int32"
            }
          },
          "spendSkip" : {
            "type" : "boolean"
          }
        }
      },
      "ArchetypeResponse" : {
        "type" : "object",
        "required" : [ "id", "name", "summary", "motto", "confident" ],
        "properties" : {
          "id" : {
            "type" : "string"
          },
          "name" : {
            "type" : "string"
          },
          "summary" : {
            "type" : "string"
          },
          "motto" : {
            "type" : "string"
          },
          "confident" : {
            "type" : "boolean"
          }
        }
      },
      "DeletionResponse" : {
        "type" : "object",
        "required" : [ "deleted", "kept" ],
        "properties" : {
          "deleted" : {
            "type" : "array",
            "items" : {
              "type" : "string"
            }
          },
          "kept" : {
            "type" : "array",
            "items" : {
              "type" : "string"
            }
          }
        }
      },
      "EntitlementResponse" : {
        "type" : "object",
        "required" : [ "remainingUses", "skipsLeft", "premium" ],
        "properties" : {
          "remainingUses" : {
            "type" : "integer",
            "format" : "int32"
          },
          "cooldownUntil" : {
            "$ref" : "#/components/schemas/Instant"
          },
          "skipsLeft" : {
            "type" : "integer",
            "format" : "int32"
          },
          "premium" : {
            "type" : "boolean"
          }
        }
      },
      "EventBatch" : {
        "type" : "object",
        "required" : [ "events" ],
        "properties" : {
          "events" : {
            "type" : "array",
            "items" : {
              "$ref" : "#/components/schemas/EventEntry"
            }
          }
        }
      },
      "EventBatchResponse" : {
        "type" : "object",
        "required" : [ "accepted", "duplicates" ],
        "properties" : {
          "accepted" : {
            "type" : "integer",
            "format" : "int32"
          },
          "duplicates" : {
            "type" : "integer",
            "format" : "int32"
          }
        }
      },
      "EventEntry" : {
        "type" : "object",
        "required" : [ "clientId", "name", "occurredAt" ],
        "properties" : {
          "clientId" : {
            "type" : "string"
          },
          "name" : {
            "type" : "string"
          },
          "occurredAt" : {
            "type" : "string",
            "$ref" : "#/components/schemas/Instant"
          },
          "properties" : {
            "type" : "object",
            "additionalProperties" : {
              "type" : "string"
            }
          }
        }
      },
      "Instant" : {
        "type" : "string",
        "format" : "date-time",
        "examples" : [ "2022-03-10T16:15:50Z" ]
      },
      "Question" : {
        "type" : "object",
        "required" : [ "id", "text" ],
        "properties" : {
          "id" : {
            "type" : "string"
          },
          "text" : {
            "type" : "string"
          }
        }
      },
      "QuestionResponse" : {
        "type" : "object",
        "required" : [ "likertPoints", "questions" ],
        "properties" : {
          "likertPoints" : {
            "type" : "integer",
            "format" : "int32"
          },
          "questions" : {
            "type" : "array",
            "items" : {
              "$ref" : "#/components/schemas/Question"
            }
          }
        }
      },
      "ResultResponse" : {
        "type" : "object",
        "required" : [ "archetype", "entitlement" ],
        "properties" : {
          "archetype" : {
            "$ref" : "#/components/schemas/ArchetypeResponse"
          },
          "entitlement" : {
            "$ref" : "#/components/schemas/EntitlementResponse"
          }
        }
      }
    },
    "securitySchemes" : {
      "SecurityScheme" : {
        "type" : "http",
        "scheme" : "bearer",
        "bearerFormat" : "JWT",
        "description" : "Authentication"
      }
    }
  },
  "paths" : {
    "/v1/entitlements" : {
      "get" : {
        "summary" : "What this device may do now",
        "operationId" : "currentEntitlement",
        "responses" : {
          "200" : {
            "description" : "OK",
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/EntitlementResponse"
                }
              }
            }
          },
          "401" : {
            "description" : "Not Authorized"
          },
          "403" : {
            "description" : "Not Allowed"
          }
        },
        "tags" : [ "Entitlement Resource" ],
        "security" : [ {
          "SecurityScheme" : [ ]
        } ]
      }
    },
    "/v1/events" : {
      "post" : {
        "summary" : "Report what happened",
        "operationId" : "recordEvents",
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/EventBatch"
              }
            }
          },
          "required" : true
        },
        "responses" : {
          "200" : {
            "description" : "OK",
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/EventBatchResponse"
                }
              }
            }
          },
          "401" : {
            "description" : "Not Authorized"
          },
          "403" : {
            "description" : "Not Allowed"
          },
          "400" : {
            "description" : "Bad Request"
          }
        },
        "tags" : [ "Event Resource" ],
        "security" : [ {
          "SecurityScheme" : [ ]
        } ]
      }
    },
    "/v1/me" : {
      "delete" : {
        "summary" : "Delete this device's data",
        "operationId" : "deleteMyData",
        "responses" : {
          "200" : {
            "description" : "OK",
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/DeletionResponse"
                }
              }
            }
          },
          "401" : {
            "description" : "Not Authorized"
          },
          "403" : {
            "description" : "Not Allowed"
          }
        },
        "tags" : [ "Entitlement Resource" ],
        "security" : [ {
          "SecurityScheme" : [ ]
        } ]
      }
    },
    "/v1/mottos/claim" : {
      "post" : {
        "summary" : "Spend a use and get a motto",
        "operationId" : "claimMotto",
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/AnswerSubmission"
              }
            }
          },
          "required" : true
        },
        "responses" : {
          "200" : {
            "description" : "OK",
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ResultResponse"
                }
              }
            }
          },
          "401" : {
            "description" : "Not Authorized"
          },
          "403" : {
            "description" : "Not Allowed"
          },
          "400" : {
            "description" : "Bad Request"
          }
        },
        "tags" : [ "Motto Resource" ],
        "security" : [ {
          "SecurityScheme" : [ ]
        } ]
      }
    },
    "/v1/tests/partial" : {
      "post" : {
        "summary" : "A first look, without spending anything",
        "operationId" : "partialResult",
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/AnswerSubmission"
              }
            }
          },
          "required" : true
        },
        "responses" : {
          "200" : {
            "description" : "OK",
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ArchetypeResponse"
                }
              }
            }
          },
          "401" : {
            "description" : "Not Authorized"
          },
          "403" : {
            "description" : "Not Allowed"
          },
          "400" : {
            "description" : "Bad Request"
          }
        },
        "tags" : [ "Test Resource" ],
        "security" : [ {
          "SecurityScheme" : [ ]
        } ]
      }
    },
    "/v1/tests/questions" : {
      "get" : {
        "summary" : "The questions to ask",
        "operationId" : "testQuestions",
        "responses" : {
          "200" : {
            "description" : "OK",
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/QuestionResponse"
                }
              }
            }
          },
          "401" : {
            "description" : "Not Authorized"
          },
          "403" : {
            "description" : "Not Allowed"
          }
        },
        "tags" : [ "Test Resource" ],
        "security" : [ {
          "SecurityScheme" : [ ]
        } ]
      }
    }
  },
  "info" : {
    "title" : "motto API",
    "version" : "1.0.0"
  }
}