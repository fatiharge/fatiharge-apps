            "type" : "object",
            "additionalProperties" : {
              "type" : "integer",
              "format" : "int32"
            }
          },
          "spendSkip" : {
            "type" : "boolean"
          }
        }
      },
      "ArchetypeContent" : {
        "type" : "object",
        "required" : [ "id", "name", "summary", "motto" ],
        "properties" : {
          "id" : {
            "type" : "string"
          },
          "name" : {
            "type" : "string"
          },
          "summary" : {
            "type" : "string"
          },
          "motto" : {
            "type" : "string"
          }
        }
      },
      "ArchetypeResponse" : {
        "type" : "object",
        "required" : [ "id", "name", "summary", "motto", "confident" ],
        "properties" : {
          "id" : {
            "type" : "string"
          },
          "name" : {
            "type" : "string"
          },
          "summary" : {
            "type" : "string"
          },
          "motto" : {
            "type" : "string"
          },
          "confident" : {
            "type" : "boolean"
          }
        }
      },
      "ChainState" : {
        "type" : "object",
        "required" : [ "started", "markedDays", "streak", "markedToday", "broken", "canFreeze", "period", "periodDone" ],
        "properties" : {
          "started" : {
            "type" : "boolean"
          },
          "startedOn" : {
            "$ref" : "#/components/schemas/LocalDate"
          },
          "markedDays" : {
            "type" : "array",
            "items" : {
              "$ref" : "#/components/schemas/MarkedDay"
            }
          },
          "freezeUsedOn" : {
            "$ref" : "#/components/schemas/LocalDate"
          },
          "streak" : {
            "type" : "integer",
            "format" : "int32"
          },
          "markedToday" : {
            "type" : "boolean"
          },
          "broken" : {
            "type" : "boolean"
          },
          "canFreeze" : {
            "type" : "boolean"
          },
          "period" : {
            "type" : "integer",
            "format" : "int32"
          },
          "mottoId" : {
            "type" : "string"
          },
          "periodDone" : {
            "type" : "boolean"
          }
        }
      },
      "Connector" : {
        "type" : "object",
        "required" : [ "id", "text" ],
        "properties" : {
          "id" : {
            "type" : "string"
          },
          "text" : {
            "type" : "string"
          }
        }
      },
      "ContentBundle" : {
        "type" : "object",
        "required" : [ "version", "archetypes", "mottos", "skeletons", "fragments", "connectors" ],
        "properties" : {
          "version" : {
            "type" : "string"
          },
          "archetypes" : {
            "type" : "array",
            "items" : {
              "$ref" : "#/components/schemas/ArchetypeContent"
            }
          },
          "mottos" : {
            "type" : "array",
            "items" : {
              "$ref" : "#/components/schemas/MottoContent"
            }
          },
          "skeletons" : {
            "type" : "array",
            "items" : {
              "$ref" : "#/components/schemas/DailySkeleton"
            }
          },
          "fragments" : {
            "type" : "array",
            "items" : {
              "$ref" : "#/components/schemas/Fragment"
            }
          },
          "connectors" : {
            "type" : "array",
            "items" : {
              "$ref" : "#/components/schemas/Connector"
            }
          }
        }
      },
      "DailySkeleton" : {
        "type" : "object",
        "required" : [ "day", "title", "body", "action" ],
