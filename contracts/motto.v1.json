          "day" : {
            "type" : "string",
            "$ref" : "#/components/schemas/LocalDate"
          },
          "mottoId" : {
            "type" : "string"
          }
        }
      },
      "PeriodReport" : {
        "type" : "object",
        "required" : [ "day", "daysMarked", "daysMadeUp", "tasksDone", "tasksOffered", "complete" ],
        "properties" : {
          "day" : {
            "type" : "integer",
            "format" : "int32"
          },
          "daysMarked" : {
            "type" : "integer",
            "format" : "int32"
          },
          "daysMadeUp" : {
            "type" : "integer",
            "format" : "int32"
          },
          "tasksDone" : {
            "type" : "integer",
            "format" : "int32"
          },
          "tasksOffered" : {
            "type" : "integer",
            "format" : "int32"
          },
          "complete" : {
            "type" : "boolean"
          }
        }
      },
      "PlayCredits" : {
        "type" : "object",
        "properties" : {
          "remaining" : {
            "type" : "integer",
            "format" : "int32"
          },
          "earned" : {
            "type" : "integer",
            "format" : "int32"
          },
          "spent" : {
            "type" : "integer",
            "format" : "int32"
          },
          "dayMarked" : {
            "type" : "boolean"
          },
          "tasksDone" : {
            "type" : "boolean"
          }
        }
      },
      "ProfileScores" : {
        "type" : "object",
        "required" : [ "openness", "conscientiousness", "extraversion", "agreeableness", "neuroticism" ],
        "properties" : {
          "openness" : {
            "type" : "number",
            "format" : "double"
          },
          "conscientiousness" : {
            "type" : "number",
            "format" : "double"
          },
          "extraversion" : {
            "type" : "number",
            "format" : "double"
          },
          "agreeableness" : {
            "type" : "number",
            "format" : "double"
          },
          "neuroticism" : {
            "type" : "number",
            "format" : "double"
          }
        }
      },
      "Question" : {
        "type" : "object",
        "required" : [ "id", "text" ],
        "properties" : {
          "id" : {
            "type" : "string"
          },
          "text" : {
            "type" : "string"
          }
        }
      },
      "QuestionResponse" : {
        "type" : "object",
        "required" : [ "likertPoints", "questions" ],
        "properties" : {
          "likertPoints" : {
            "type" : "integer",
            "format" : "int32"
          },
          "questions" : {
            "type" : "array",
            "items" : {
              "$ref" : "#/components/schemas/Question"
            }
          }
        }
      },
      "ReportSection" : {
        "type" : "object",
        "required" : [ "section", "opening", "reading", "fragment" ],
        "properties" : {
          "section" : {
            "type" : "integer",
            "format" : "int32"
          },
          "opening" : {
            "type" : "string"
          },
          "reading" : {
            "type" : "string"
          },
          "fragment" : {
            "type" : "string"
          }
        }
      },
      "ResultHistory" : {
        "type" : "object",
        "required" : [ "results" ],
        "properties" : {
          "results" : {
            "type" : "array",
            "items" : {
              "$ref" : "#/components/schemas/ResultSummary"
            }
          }
        }
      },
      "ResultReport" : {
        "type" : "object",
        "required" : [ "resultId", "archetypeId", "overview", "readings", "strength", "cost" ],
        "properties" : {
          "resultId" : {
            "type" : "integer",
            "format" : "int64"
          },
          "archetypeId" : {
            "type" : "string"
          },
          "overview" : {
            "type" : "string"
          },
          "readings" : {
            "type" : "array",
            "items" : {
              "$ref" : "#/components/schemas/DimensionReading"
            }
