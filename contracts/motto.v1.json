          "title" : {
            "type" : "string"
          },
          "detail" : {
            "type" : "string"
          },
          "done" : {
            "type" : "boolean"
          }
        }
      },
      "DailyTasks" : {
        "type" : "object",
        "required" : [ "day", "tasks" ],
