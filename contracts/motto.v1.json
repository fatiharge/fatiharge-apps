          "skipsLeft" : {
            "type" : "integer",
            "format" : "int32"
          },
          "premium" : {
            "type" : "boolean"
          }
        }
      },
      "EventBatch" : {
        "type" : "object",
        "required" : [ "events" ],
        "properties" : {
          "events" : {
            "type" : "array",
            "items" : {
